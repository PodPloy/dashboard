{
	"name": "dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitejs/devtools-vitest": "^0.8.3",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"storybook": "^10.6.8",
		"@storybook/sveltekit": "^10.6.8",
		"@storybook/addon-svelte-csf": "latest",
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-vitest": "^10.6.8",
		"@storybook/addon-a11y": "^10.6.8",
		"@storybook/addon-docs": "^10.6.8",
		"eslint-plugin-storybook": "^10.6.8",
		"@vitest/coverage-v8": "^5.1.0"
	}
}
